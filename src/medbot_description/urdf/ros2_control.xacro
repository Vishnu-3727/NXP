<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ros2_control hardware for Gazebo Harmonic + the gz_ros2_control plugin.
       Controller params come from controllers.yaml, path passed in at launch. -->

  <xacro:arg name="controllers_config" default=""/>

  <xacro:macro name="wheel_control" params="name">
    <joint name="${name}_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </xacro:macro>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:wheel_control name="front_left"/>
    <xacro:wheel_control name="front_right"/>
    <xacro:wheel_control name="rear_left"/>
    <xacro:wheel_control name="rear_right"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_config)</parameters>
    </plugin>
  </gazebo>

</robot>
