<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>medbot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch composing the full medical-response simulation.</description>
  <maintainer email="vishnuvardhanks113@gmail.com">vishnu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>medbot_description</exec_depend>
  <exec_depend>medbot_gazebo</exec_depend>
  <exec_depend>medbot_localization</exec_depend>
  <exec_depend>medbot_navigation</exec_depend>
  <exec_depend>medbot_perception</exec_depend>
  <exec_depend>medbot_behavior</exec_depend>
  <exec_depend>medbot_control</exec_depend>
  <exec_depend>twist_mux</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
